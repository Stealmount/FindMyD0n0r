# Public application URL used for same-origin API requests and generated links.
APP_URL=http://localhost:5000

# ─── Firebase (Server) ─────────────────────────────────────────────────────────
# Firebase Admin SDK service account credentials.
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase (Frontend / Vite) ────────────────────────────────────────────────
# These are exposed to the browser via VITE_ prefix.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Admin Panel ───────────────────────────────────────────────────────────────
# Frontend admin gate (Vite): must equal the Firebase Auth admin email and
# backend ADMIN_EMAILS.
VITE_ADMIN_EMAIL=official@findmydonor.online
# Admin email+password login (Firebase Auth).
ADMIN_EMAIL=official@findmydonor.online
ADMIN_PASSWORD=
# Secondary admin auth (API-level secret, kept for backward compat).
ADMIN_AUTH_SECRET=
# Comma-separated admin emails allowed to use /api/admin/* routes.
ADMIN_EMAILS=official@findmydonor.online

# ─── WhatsApp (WAHA) ──────────────────────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_WEBHOOK_SECRET= # unused - implement HMAC or remove

# ─── Upstash Redis (THE data store) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Namespace prefix for all app keys. Tests override to fmdt:
UPSTASH_KEY_PREFIX=fmd:

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY= # dashboard key, sending_access scope
# staged rollout - verify domain in Resend dashboard before switching to production sender
RESEND_SENDER_EMAIL="FindMyDonor <official@findmydonor.online>"

# ─── Messaging Queue ───────────────────────────────────────────────────────────
MESSAGE_DELAY_SECONDS=60
MESSAGE_POLL_INTERVAL_MS=5000
MESSAGE_MAX_RETRIES=5
MESSAGE_CLAIM_STALE_SECONDS=120

# ─── Onboarding & Notifications ────────────────────────────────────────────────
WELCOME_DELAY_SECONDS=30
NOTIFICATION_DEFAULT_CHANNEL=both

# ─── Environment & CORS ────────────────────────────────────────────────────────
NODE_ENV=development
CORS_ORIGINS=https://findmydonor.online,https://www.findmydonor.online,http://localhost:5173,http://localhost:5000,http://localhost:3000,http://localhost:6001,http://localhost:7000,http://127.0.0.1:5173,http://127.0.0.1:5000,http://127.0.0.1:3000,http://127.0.0.1:6001,http://127.0.0.1:7000
