# Isolated verification environment for findmydonor0 ("lahu")
FROM node:22-bookworm-slim

WORKDIR /app

# Native deps used by the toolchain (esbuild/tailwind need python/make only rarely;
# bookworm-slim covers them). Install JS deps first for layer caching.
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

# App source (secrets NOT baked in — .env is mounted at runtime)
COPY . .

ENV NODE_ENV=development
CMD ["bash"]
