{
  "name": "lahu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"cross-env PORT=5001 tsx backend/server.ts\" \"vite\"",
    "dev:api": "cross-env PORT=5001 tsx backend/server.ts",
    "dev:web": "vite",
    "dev:admin": "tsx backend/admin-server.ts",
    "start": "concurrently -n server,admin,frontend -c blue,yellow,green \"cross-env PORT=5001 tsx backend/server.ts\" \"tsx backend/admin-server.ts\" \"vite\"",
    "start:admin": "concurrently -n api,admin -c blue,yellow \"cross-env PORT=5001 tsx backend/server.ts\" \"tsx backend/admin-server.ts\"",
    "build": "vite build && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:admin": "esbuild backend/admin-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/admin-server.cjs",
    "build:all": "npm run build && npm run build:admin",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-force-exit backend/tests/p0-blockers.test.ts backend/tests/auth.test.ts backend/tests/matching.test.ts backend/tests/simulator.test.ts backend/tests/hospital.test.ts backend/tests/whatsapp-safety.test.ts backend/tests/contact-profile.test.ts backend/tests/dashboard-onboarding.test.ts backend/tests/cascade.test.ts backend/tests/donor-privacy.test.ts backend/tests/institution-flow.test.ts",
    "pretest": "tsx backend/scripts/flush-test-store.ts",
    "test:auth": "tsx --test --test-force-exit backend/tests/auth.test.ts",
    "pretest:auth": "tsx backend/scripts/flush-test-store.ts",
    "test:matching": "tsx --test --test-force-exit backend/tests/matching.test.ts",
    "pretest:matching": "tsx backend/scripts/flush-test-store.ts",
    "test:security": "tsx --test --test-force-exit backend/tests/security.test.ts",
    "pretest:security": "tsx backend/scripts/flush-test-store.ts",
    "test:admin": "tsx --test --test-force-exit backend/tests/admin.test.ts",
    "test:all": "tsx --test --test-force-exit backend/tests/*.test.ts",
    "pretest:all": "tsx backend/scripts/flush-test-store.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@upstash/redis": "^1.38.2",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.0",
    "resend": "^6.16.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
